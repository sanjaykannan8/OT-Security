{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sih26145:schema:model-manifest:1.0.0",
  "title": "Model bundle metadata.json, version 1.0.0",
  "description": "One per immutable model version directory models/<threat>/<version>/. Only written by model-training for an actually trained and evaluated model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version", "threat", "model_version", "created_at", "model_file", "model_sha256",
    "onnx", "runtime", "inputs", "outputs", "feature_schema", "preprocessing", "required_fields",
    "missingness_policy", "output_semantics", "decision_threshold", "calibration", "dataset", "split",
    "evaluation", "training", "explanation"
  ],
  "properties": {
    "manifest_schema_version": { "const": "1.0.0" },
    "threat": { "enum": [ "dga", "dns_tunnel", "beacon", "encrypted", "ddos", "scan", "exfiltration" ] },
    "model_version": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "created_at": { "type": "string", "maxLength": 32, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" },
    "model_file": { "const": "model.onnx" },
    "model_sha256": { "$ref": "#/$defs/sha256" },
    "onnx": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "ir_version", "opset", "producer", "exporter" ],
      "properties": {
        "ir_version": { "type": "integer", "minimum": 3, "maximum": 11 },
        "opset": { "type": "integer", "minimum": 7, "maximum": 24 },
        "producer": { "type": "string", "maxLength": 64 },
        "exporter": { "type": "string", "maxLength": 128 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "onnxruntime_verified_versions", "intra_op_threads", "inter_op_threads", "execution_provider" ],
      "properties": {
        "onnxruntime_verified_versions": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 32 } },
        "intra_op_threads": { "type": "integer", "minimum": 1, "maximum": 8 },
        "inter_op_threads": { "type": "integer", "minimum": 1, "maximum": 8 },
        "execution_provider": { "const": "CPUExecutionProvider" }
      }
    },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tensor" } },
    "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tensor" } },
    "feature_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "file", "version", "sha256", "dimension" ],
      "properties": {
        "file": { "type": "string", "maxLength": 128 },
        "version": { "type": "string", "pattern": "^[a-z_]{1,32}-[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "dimension": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "file", "sha256", "description" ],
      "properties": {
        "file": { "type": "string", "maxLength": 128 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "description": { "type": "string", "maxLength": 1024 }
      }
    },
    "required_fields": { "type": "array", "items": { "type": "string", "maxLength": 64 } },
    "missingness_policy": { "enum": [ "abstain", "impute_with_indicator" ] },
    "output_semantics": { "type": "string", "maxLength": 1024 },
    "decision_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "status", "method", "version", "confidence_kind", "notes", "metrics" ],
      "properties": {
        "status": { "enum": [ "calibrated", "simulation_only", "uncalibrated" ] },
        "method": { "enum": [ "none", "sigmoid", "isotonic", "temperature" ] },
        "version": { "anyOf": [ { "type": "string", "maxLength": 64 }, { "type": "null" } ] },
        "confidence_kind": { "enum": [ "calibrated_probability", "heuristic_score" ] },
        "notes": { "type": "string", "maxLength": 1024 },
        "metrics": { "type": "object" }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "simulation_only", "description", "generator", "seeds", "files" ],
      "properties": {
        "simulation_only": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 2048 },
        "generator": { "type": "string", "maxLength": 128 },
        "seeds": { "type": "object" },
        "files": {
          "type": "object",
          "additionalProperties": { "type": "object", "required": [ "sha256", "rows" ], "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "rows": { "type": "integer", "minimum": 0 } } }
        }
      }
    },
    "split": { "type": "object", "required": [ "method" ], "properties": { "method": { "type": "string", "maxLength": 512 } } },
    "evaluation": { "type": "object" },
    "training": {
      "type": "object",
      "required": [ "python_version", "numpy_version", "sklearn_version", "seed", "estimator", "params" ],
      "properties": {
        "python_version": { "type": "string" },
        "numpy_version": { "type": "string" },
        "sklearn_version": { "type": "string" },
        "seed": { "type": "integer" },
        "estimator": { "type": "string" },
        "params": { "type": "object" }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "type", "intercept", "coefficients", "means", "scales" ],
      "properties": {
        "type": { "const": "linear_contributions" },
        "intercept": { "type": "number" },
        "coefficients": { "type": "array", "items": { "type": "number" } },
        "means": { "type": "array", "items": { "type": "number" } },
        "scales": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "name", "dtype", "shape" ],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
        "dtype": { "enum": [ "float32", "float64", "int64" ] },
        "shape": { "type": "array", "items": { "type": "integer", "minimum": -1 } },
        "semantics": { "type": "string", "maxLength": 512 }
      }
    }
  }
}
