{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sih26145:schema:alert:1.0.0",
  "title": "Incident update (alert), version 1.0.0",
  "description": "Published on alerts.v1 by the Flink incident correlator. Each message is one append-only update of an incident. Times named *_time/first_seen/last_seen/window_* are observation time (event_time + replay_time_offset_us) unless stated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alert_schema_version", "alert_id", "incident_id", "update_id", "update_seq", "status", "timestamp",
    "event_time", "observation_time", "replay_time_offset_us", "evidence_received_at", "sensor_id",
    "replay_run_id", "flow_id", "src_ip", "src_port", "dst_ip", "dst_port", "protocol", "entity",
    "threat_class", "subtype", "severity", "confidence", "confidence_kind", "calibration_status",
    "model_version", "detector_version", "feature_schema_version", "detection_method", "evidence",
    "top_features", "explanation", "window_start", "window_end", "first_seen", "last_seen", "dedup_key"
  ],
  "properties": {
    "alert_schema_version": { "const": "1.0.0" },
    "alert_id": { "$ref": "#/$defs/uuid", "description": "Deterministic id of the detector finding: UUIDv5(ALERT_NAMESPACE, detector|entity|window_end|subtype)." },
    "incident_id": { "$ref": "#/$defs/uuid", "description": "Deterministic: UUIDv5(INCIDENT_NAMESPACE, threat_class|entity.type|entity.key|incident_epoch_ms)." },
    "update_id": { "$ref": "#/$defs/uuid", "description": "Deterministic: UUIDv5(UPDATE_NAMESPACE, incident_id|update_seq). Consumers deduplicate on it." },
    "update_seq": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "status": { "enum": [ "new", "updated", "escalated", "resolved" ] },
    "timestamp": { "$ref": "#/$defs/timestamp", "description": "Wall clock when Flink emitted this update." },
    "event_time": { "$ref": "#/$defs/timestamp", "description": "Original capture time of the latest contributing evidence." },
    "observation_time": { "$ref": "#/$defs/timestamp" },
    "replay_time_offset_us": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "evidence_received_at": { "$ref": "#/$defs/timestamp", "description": "Latest receiver_received_at among the events that made the evidence sufficient. Latency start point." },
    "sensor_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "replay_run_id": { "anyOf": [ { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" }, { "type": "null" } ] },
    "flow_id": {
      "anyOf": [ { "type": "string", "maxLength": 200 }, { "type": "null" } ],
      "description": "sensor_id|sensor_boot_id|replay_run_id|uid of a representative flow; null for aggregate detections."
    },
    "src_ip": { "$ref": "#/$defs/ip_or_null", "description": "Null when the finding aggregates many sources (e.g. flood victim entity)." },
    "src_port": { "$ref": "#/$defs/port_or_null", "description": "Null unless a single source port characterises the finding." },
    "dst_ip": { "$ref": "#/$defs/ip_or_null", "description": "Null when the finding aggregates many destinations (e.g. horizontal scan)." },
    "dst_port": { "$ref": "#/$defs/port_or_null" },
    "protocol": { "enum": [ "tcp", "udp", "icmp", "unknown_transport", "mixed", null ] },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "type", "key" ],
      "properties": {
        "type": { "enum": [ "src_host", "dst_host", "dst_service", "service_pair", "src_domain" ] },
        "key": { "type": "string", "minLength": 1, "maxLength": 320 }
      }
    },
    "threat_class": { "enum": [ "ddos", "beaconing", "dga", "dns_tunnel", "encrypted_malware_like", "scan", "exfiltration" ] },
    "subtype": {
      "enum": [
        "syn_flood", "udp_amplification_like", "spoofed_source_like_flood", "volumetric_flood",
        "periodic_beacon", "dga_domain", "dga_nxdomain_burst", "dns_tunnel_like",
        "suspicious_tls_metadata", "horizontal_scan", "vertical_scan", "sustained_upload"
      ]
    },
    "severity": { "enum": [ "info", "low", "medium", "high", "critical" ] },
    "confidence": { "anyOf": [ { "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" } ] },
    "confidence_kind": { "enum": [ "calibrated_probability", "heuristic_score", "unavailable" ] },
    "calibration_status": { "enum": [ "calibrated", "simulation_only", "uncalibrated", "not_applicable" ] },
    "model_version": { "anyOf": [ { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" }, { "type": "null" } ] },
    "detector_version": { "type": "string", "pattern": "^[a-z_]{1,32}-[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "feature_schema_version": { "type": "string", "pattern": "^[a-z_]{1,32}-[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "detection_method": { "enum": [ "rule", "statistical", "model", "hybrid" ] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "observed", "thresholds", "baseline", "visibility", "model_eligibility", "raw_event_ids", "raw_event_ids_truncated", "evidence_count" ],
      "properties": {
        "observed": { "$ref": "#/$defs/scalar_map" },
        "thresholds": { "$ref": "#/$defs/number_map" },
        "baseline": { "$ref": "#/$defs/number_map" },
        "visibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "observation_coverage", "unavailable_features", "capped_features" ],
          "properties": {
            "observation_coverage": { "enum": [ "both_directions", "originator_only", "responder_only", "unknown", "mixed" ] },
            "unavailable_features": { "type": "array", "maxItems": 64, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } },
            "capped_features": { "type": "array", "maxItems": 64, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } }
          }
        },
        "model_eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "eligible", "reason" ],
          "properties": {
            "eligible": { "type": "boolean" },
            "reason": { "anyOf": [ { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" }, { "type": "null" } ] }
          }
        },
        "raw_event_ids": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/uuid" } },
        "raw_event_ids_truncated": { "type": "boolean" },
        "evidence_count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "top_features": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "name", "value", "contribution", "unit" ],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "value": { "type": [ "number", "null" ] },
          "contribution": { "type": [ "number", "null" ], "description": "Signed linear contribution to the model logit; null for rule features." },
          "unit": { "anyOf": [ { "type": "string", "maxLength": 32 }, { "type": "null" } ] }
        }
      }
    },
    "explanation": { "type": "string", "maxLength": 1024, "description": "Plain text generated from a template. Contains observed values only; render as text." },
    "window_start": { "$ref": "#/$defs/timestamp" },
    "window_end": { "$ref": "#/$defs/timestamp" },
    "first_seen": { "$ref": "#/$defs/timestamp" },
    "last_seen": { "$ref": "#/$defs/timestamp" },
    "dedup_key": { "type": "string", "minLength": 1, "maxLength": 400 }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "timestamp": {
      "type": "string", "maxLength": 32, "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "ip_or_null": { "anyOf": [ { "type": "string", "maxLength": 45, "anyOf": [ { "format": "ipv4" }, { "format": "ipv6" } ] }, { "type": "null" } ] },
    "port_or_null": { "anyOf": [ { "type": "integer", "minimum": 0, "maximum": 65535 }, { "type": "null" } ] },
    "scalar_map": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
      "additionalProperties": { "anyOf": [ { "type": "number" }, { "type": "boolean" }, { "type": "string", "maxLength": 255 }, { "type": "null" } ] }
    },
    "number_map": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
      "additionalProperties": { "type": [ "number", "null" ] }
    }
  }
}
