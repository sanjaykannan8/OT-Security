{
  "feature_schema_version": "dga_lexical-1.0.0",
  "description": "Ordered lexical features of the registrable second-level label (SLD) of a DNS query name. Implemented once in lib/sih_common/dga_features.py and used by both training and the PyFlink runtime.",
  "input": "DNS query name (payload.query of a dns event)",
  "normalization": "lowercase, strip trailing dot; registrable domain = SLD + public suffix from a packaged multi-label suffix list; names ending in local/localdomain/lan/internal/home/arpa/corp/intranet/test/invalid and IP literals are not registrable",
  "eligibility": "query available, registrable, SLD length >= 6; otherwise the model abstains with a reason code",
  "symbols": "abcdefghijklmnopqrstuvwxyz0123456789- plus boundary ^ $ and ? for any other character",
  "features": [
    {"index": 0, "name": "sld_len", "unit": "chars", "formula": "min(len(sld), 63)"},
    {"index": 1, "name": "sld_entropy", "unit": "bits/char", "formula": "Shannon entropy of the SLD characters"},
    {"index": 2, "name": "sld_digit_ratio", "unit": "ratio", "formula": "digits / len(sld)"},
    {"index": 3, "name": "sld_vowel_ratio", "unit": "ratio", "formula": "count(aeiou) / len(sld)"},
    {"index": 4, "name": "sld_consonant_ratio", "unit": "ratio", "formula": "count(consonants) / len(sld)"},
    {"index": 5, "name": "sld_max_consonant_run", "unit": "chars", "formula": "min(longest consonant run, 63)"},
    {"index": 6, "name": "sld_max_digit_run", "unit": "chars", "formula": "min(longest digit run, 63)"},
    {"index": 7, "name": "sld_hyphen_count", "unit": "count", "formula": "min(count('-'), 10)"},
    {"index": 8, "name": "sld_unique_char_ratio", "unit": "ratio", "formula": "distinct chars / len(sld)"},
    {"index": 9, "name": "sld_hex_ratio", "unit": "ratio", "formula": "count([0-9a-f]) / len(sld)"},
    {"index": 10, "name": "query_len", "unit": "chars", "formula": "min(len(normalized query), 253)"},
    {"index": 11, "name": "subdomain_depth", "unit": "labels", "formula": "min(labels left of the SLD, 10)"},
    {"index": 12, "name": "suffix_label_count", "unit": "labels", "formula": "labels in the public suffix (1 or 2)"},
    {"index": 13, "name": "sld_bigram_logprob_mean", "unit": "nats", "formula": "mean ln P(b|a) over bigrams of ^sld$ from the benign training bigram table (preprocessing.json)"},
    {"index": 14, "name": "sld_bigram_hash_00", "unit": "ratio", "formula": "fraction of ^sld$ bigrams with fnv1a32(bigram) % 32 == 0"},
    {"index": 15, "name": "sld_bigram_hash_01", "unit": "ratio", "formula": "bucket 1"},
    {"index": 16, "name": "sld_bigram_hash_02", "unit": "ratio", "formula": "bucket 2"},
    {"index": 17, "name": "sld_bigram_hash_03", "unit": "ratio", "formula": "bucket 3"},
    {"index": 18, "name": "sld_bigram_hash_04", "unit": "ratio", "formula": "bucket 4"},
    {"index": 19, "name": "sld_bigram_hash_05", "unit": "ratio", "formula": "bucket 5"},
    {"index": 20, "name": "sld_bigram_hash_06", "unit": "ratio", "formula": "bucket 6"},
    {"index": 21, "name": "sld_bigram_hash_07", "unit": "ratio", "formula": "bucket 7"},
    {"index": 22, "name": "sld_bigram_hash_08", "unit": "ratio", "formula": "bucket 8"},
    {"index": 23, "name": "sld_bigram_hash_09", "unit": "ratio", "formula": "bucket 9"},
    {"index": 24, "name": "sld_bigram_hash_10", "unit": "ratio", "formula": "bucket 10"},
    {"index": 25, "name": "sld_bigram_hash_11", "unit": "ratio", "formula": "bucket 11"},
    {"index": 26, "name": "sld_bigram_hash_12", "unit": "ratio", "formula": "bucket 12"},
    {"index": 27, "name": "sld_bigram_hash_13", "unit": "ratio", "formula": "bucket 13"},
    {"index": 28, "name": "sld_bigram_hash_14", "unit": "ratio", "formula": "bucket 14"},
    {"index": 29, "name": "sld_bigram_hash_15", "unit": "ratio", "formula": "bucket 15"},
    {"index": 30, "name": "sld_bigram_hash_16", "unit": "ratio", "formula": "bucket 16"},
    {"index": 31, "name": "sld_bigram_hash_17", "unit": "ratio", "formula": "bucket 17"},
    {"index": 32, "name": "sld_bigram_hash_18", "unit": "ratio", "formula": "bucket 18"},
    {"index": 33, "name": "sld_bigram_hash_19", "unit": "ratio", "formula": "bucket 19"},
    {"index": 34, "name": "sld_bigram_hash_20", "unit": "ratio", "formula": "bucket 20"},
    {"index": 35, "name": "sld_bigram_hash_21", "unit": "ratio", "formula": "bucket 21"},
    {"index": 36, "name": "sld_bigram_hash_22", "unit": "ratio", "formula": "bucket 22"},
    {"index": 37, "name": "sld_bigram_hash_23", "unit": "ratio", "formula": "bucket 23"},
    {"index": 38, "name": "sld_bigram_hash_24", "unit": "ratio", "formula": "bucket 24"},
    {"index": 39, "name": "sld_bigram_hash_25", "unit": "ratio", "formula": "bucket 25"},
    {"index": 40, "name": "sld_bigram_hash_26", "unit": "ratio", "formula": "bucket 26"},
    {"index": 41, "name": "sld_bigram_hash_27", "unit": "ratio", "formula": "bucket 27"},
    {"index": 42, "name": "sld_bigram_hash_28", "unit": "ratio", "formula": "bucket 28"},
    {"index": 43, "name": "sld_bigram_hash_29", "unit": "ratio", "formula": "bucket 29"},
    {"index": 44, "name": "sld_bigram_hash_30", "unit": "ratio", "formula": "bucket 30"},
    {"index": 45, "name": "sld_bigram_hash_31", "unit": "ratio", "formula": "bucket 31"}
  ]
}
