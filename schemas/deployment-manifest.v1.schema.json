{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sih26145:schema:deployment-manifest:1.0.0",
  "title": "Model deployment manifest (models/deployment.json), version 1.0.0",
  "description": "Selects exactly one immutable version per threat. Changing it is a controlled savepoint + redeploy. Flink never downloads models.",
  "type": "object",
  "additionalProperties": false,
  "required": [ "deployment_manifest_version", "updated_at", "models" ],
  "properties": {
    "deployment_manifest_version": { "const": "1.0.0" },
    "updated_at": { "type": "string", "maxLength": 32, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" },
    "note": { "type": "string", "maxLength": 1024 },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dga": { "$ref": "#/$defs/selection" },
        "dns_tunnel": { "$ref": "#/$defs/selection" },
        "beacon": { "$ref": "#/$defs/selection" },
        "encrypted": { "$ref": "#/$defs/selection" },
        "ddos": { "$ref": "#/$defs/selection" },
        "scan": { "$ref": "#/$defs/selection" },
        "exfiltration": { "$ref": "#/$defs/selection" }
      }
    }
  },
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "enabled", "version", "model_sha256", "metadata_sha256" ],
      "properties": {
        "enabled": { "type": "boolean" },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "model_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "metadata_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
