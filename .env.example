# Copy to .env to override defaults. Names and non-secret settings only: credentials are generated into
# ./secrets by scripts/provision-secrets.sh and mounted as files.
COMPOSE_PROJECT_NAME=sih
SIH_IMAGE_TAG=1.0.0

# Simulated sensor side
SENDER_REPLAY_SPEED=1
LINK_REDUNDANCY=1

# SOC side
RECEIVER_SPOOL_MAX_BYTES=1073741824
NOTIFY_MIN_SEVERITY=medium
HOT_RETENTION_DAYS=90
ARCHIVE_INTERVAL_S=300
ARCHIVE_RETENTION=7d
API_HOST_PORT=8080
# Set true when the API is served behind TLS termination.
API_COOKIE_SECURE=false
